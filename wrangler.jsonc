{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tally-wrapper",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tally-wrapper",
      "database_id": "797447fd-47de-493c-a6dd-033111f25107",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "7d2af08453e447849f6611709557732e"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "TallyMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TallyMCP"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
